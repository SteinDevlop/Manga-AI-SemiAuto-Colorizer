# =====================================================================
# Manga Colorizer - Variables de entorno
#
# Para Docker Compose: copia este archivo a `docker/.env` (junto a docker-compose.yml)
# y ajusta los valores. `.env` esta en .gitignore: nunca se commitea.
# =====================================================================

COMPOSE_PROJECT_NAME=manga-colorizer

# ---- PostgreSQL ----
POSTGRES_USER=manga
POSTGRES_PASSWORD=manga_dev_change_me
POSTGRES_DB=manga_colorizer
# Driver asyncpg (el unico instalado). NO usar postgresql+psycopg://
DATABASE_URL=postgresql+asyncpg://manga:manga_dev_change_me@postgres:5432/manga_colorizer

# ---- Redis / Celery ----
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# ---------------------------------------------------------------------
# Seguridad (autenticacion JWT). OBLIGATORIO cambiar en produccion:
# con ENVIRONMENT=production la API NO arranca si SECRET_KEY o ENCRYPTION_KEY
# son debiles o faltan.
#   SECRET_KEY:     python -c "import secrets; print(secrets.token_urlsafe(48))"
#   ENCRYPTION_KEY: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ---------------------------------------------------------------------
ENVIRONMENT=development
SECRET_KEY=dev-only-insecure-secret-key-do-not-use-in-production
ENCRYPTION_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=30
# Orígenes permitidos por CORS (separados por coma)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Administrador inicial (solo se crea si la tabla de usuarios esta vacia).
# Alternativa: docker compose exec api python -m app.cli create-user --email you@example.com --admin
FIRST_ADMIN_EMAIL=
FIRST_ADMIN_PASSWORD=

# ---- API ----
API_HOST=0.0.0.0
API_PORT=8000

# ---- Frontend (incluir /api/v1) ----
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_PORT=5173

# ---- Colas Celery: deben coincidir con task_routes de celery_app.py ----
WORKER_CPU_QUEUES=WORKER_CPU_QUEUES
WORKER_GPU_QUEUES=colorization
