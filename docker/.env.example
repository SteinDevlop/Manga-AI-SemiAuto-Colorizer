# =====================================================================
# Manga Colorizer - Variables de entorno para Docker Compose
#
# Copia este archivo a `docker/.env` (junto a docker-compose.yml) y ajusta
# los valores antes de levantar la pila. `.env` esta en .gitignore:
# nunca se commitea.
# =====================================================================

# Nombre del proyecto de Compose (prefijo de contenedores, redes y volumenes)
COMPOSE_PROJECT_NAME=manga-colorizer

# ---------------------------------------------------------------------
# PostgreSQL: metadatos del monolito. Solo red interna, nunca al host.
# ---------------------------------------------------------------------
POSTGRES_USER=manga
POSTGRES_PASSWORD=manga_dev_change_me
POSTGRES_DB=manga_colorizer
POSTGRES_DATA_DIR=./data/postgres

# URL de conexion del API y los workers (misma red interna de Compose)
DATABASE_URL=postgresql+psycopg://manga:manga_dev_change_me@postgres:5432/manga_colorizer

# ---------------------------------------------------------------------
# Redis: broker de Celery y cache. Solo red interna, nunca al host.
# ---------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# ---------------------------------------------------------------------
# API FastAPI: expuesta solo en localhost (puerto 8000)
# ---------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000

# ---------------------------------------------------------------------
# Frontend Vite: expuesto solo en localhost (puerto 5173)
# ---------------------------------------------------------------------
VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_PORT=5173

# ---------------------------------------------------------------------
# Seguridad y workers
# ---------------------------------------------------------------------
SECRET_KEY=dev-secret-change-in-production
WORKER_CPU_QUEUES=celery,image-analysis,palette
WORKER_GPU_QUEUES=colorization